// Fractional k truncates toward zero: 1.5 selects one series, 2.9 selects two, and 0.5 selects none.
// Run the same cases in both k8s and prometheus-k8s; only the metadata layout differs.

topk_fractional_k_one
required_capability: promql_command_v0
required_capability: promql_topk
required_capability: fix_promql_time_bucket_v2
required_capability: fix_promql_fractional_k_truncation
PROMQL index=k8s step=1h result=(topk(1.5, network.total_bytes_in{cluster="prod"}))
| SORT result DESC;

result:double | step:datetime | _timeseries:keyword
10277.0 | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""two"",""region"":[""eu"",""us""]}"
;

topk_fractional_k_two
required_capability: promql_command_v0
required_capability: promql_topk
required_capability: fix_promql_time_bucket_v2
required_capability: fix_promql_fractional_k_truncation
PROMQL index=k8s step=1h result=(topk(2.9, network.total_bytes_in{cluster="prod"}))
| SORT result DESC;

result:double | step:datetime | _timeseries:keyword
10277.0 | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""two"",""region"":[""eu"",""us""]}"
9969.0 | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""three"",""region"":[""eu"",""us""]}"
;

topk_fractional_k_below_one
required_capability: promql_command_v0
required_capability: promql_topk
required_capability: fix_promql_time_bucket_v2
required_capability: fix_promql_fractional_k_truncation
PROMQL index=k8s step=1h result=(topk(0.5, network.total_bytes_in{cluster="prod"}))
| SORT result DESC;

result:double | step:datetime | _timeseries:keyword
;

bottomk_fractional_k_one
required_capability: promql_command_v0
required_capability: promql_bottomk
required_capability: fix_promql_time_bucket_v2
required_capability: fix_promql_fractional_k_truncation
PROMQL index=k8s step=1h result=(bottomk(1.5, network.total_bytes_in{cluster="prod"}))
| SORT result ASC;

result:double | step:datetime | _timeseries:keyword
947.0 | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""one"",""region"":[""eu"",""us""]}"
;

bottomk_fractional_k_two
required_capability: promql_command_v0
required_capability: promql_bottomk
required_capability: fix_promql_time_bucket_v2
required_capability: fix_promql_fractional_k_truncation
PROMQL index=k8s step=1h result=(bottomk(2.9, network.total_bytes_in{cluster="prod"}))
| SORT result ASC;

result:double | step:datetime | _timeseries:keyword
947.0 | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""one"",""region"":[""eu"",""us""]}"
9969.0 | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""three"",""region"":[""eu"",""us""]}"
;

bottomk_fractional_k_below_one
required_capability: promql_command_v0
required_capability: promql_bottomk
required_capability: fix_promql_time_bucket_v2
required_capability: fix_promql_fractional_k_truncation
PROMQL index=k8s step=1h result=(bottomk(0.5, network.total_bytes_in{cluster="prod"}))
| SORT result ASC;

result:double | step:datetime | _timeseries:keyword
;

limitk_fractional_k_one
required_capability: promql_command_v0
required_capability: promql_limitk
required_capability: fix_promql_time_bucket_v2
required_capability: fix_promql_fractional_k_truncation
PROMQL index=k8s step=1h result=(limitk(1.5, network.total_bytes_in{cluster="prod"}))
| STATS series = COUNT(*) BY step;

series:long | step:datetime
1 | 2024-05-10T01:00:00.000Z
;

limitk_fractional_k_two
required_capability: promql_command_v0
required_capability: promql_limitk
required_capability: fix_promql_time_bucket_v2
required_capability: fix_promql_fractional_k_truncation
PROMQL index=k8s step=1h result=(limitk(2.9, network.total_bytes_in{cluster="prod"}))
| STATS series = COUNT(*) BY step;

series:long | step:datetime
2 | 2024-05-10T01:00:00.000Z
;

limitk_fractional_k_below_one
required_capability: promql_command_v0
required_capability: promql_limitk
required_capability: fix_promql_time_bucket_v2
required_capability: fix_promql_fractional_k_truncation
PROMQL index=k8s step=1h result=(limitk(0.5, network.total_bytes_in{cluster="prod"}))
| SORT result ASC;

result:double | step:datetime | _timeseries:keyword
;
